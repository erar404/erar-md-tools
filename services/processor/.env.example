# Must match PROCESSOR_SERVICE_TOKEN in the Next.js app's .env.local
PROCESSOR_SERVICE_TOKEN=

# Service-role Supabase access — same project as the Next.js app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local scratch space for downloads/conversions before upload; wiped per job
PROCESSOR_TMP_DIR=/tmp/md-tools-processor

# Demucs model — htdemucs is the default 4-source (vocals/drums/bass/other) model
DEMUCS_MODEL=htdemucs
